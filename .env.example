# Database
POSTGRES_USER=factory
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=factory

# Neo4j
NEO4J_AUTH=neo4j/your_neo4j_password
NEO4J_PASSWORD=your_neo4j_password

# LLM (Gemini) — optional, not used when switching to DeepSeek+Qwen
GEMINI_API_KEY=

# DeepSeek (Developer/QA/Engram processing)
DEEPSEEK_API_KEY=your_deepseek_api_key

# Qwen (Alibaba Cloud DashScope) — used for PO, Architect, SecOps
QWEN_API_KEY=your_qwen_api_key

# Nebius Token Factory — serves the NVIDIA open models (Nemotron). Model ids
# carry a vendor segment, e.g. nvidia/Llama-3.1-Nemotron-70B-Instruct.
NEBIUS_API_KEY=your_nebius_token_factory_api_key
# Point this at a Nebius Serverless Endpoint if you deploy your own.
NEBIUS_PROXY_URL=https://api.tokenfactory.nebius.com/v1

# LLM proxy: time budget for one chat request's provider calls, fallbacks
# included. The backend reads it too: its client waits this plus 10 s, so an
# answer the provider is still writing (and billing) is never given up on.
LLM_UPSTREAM_TIMEOUT_SECONDS=110

# One model for the whole team, e.g. AGENT_MODEL=deepseek-v4-pro to run every
# role on DeepSeek alone (then only DEEPSEEK_API_KEY is needed). A role's own
# variable wins over it: AGENT_MODEL_PO, AGENT_MODEL_ARCHITECT,
# AGENT_MODEL_SCRUM_MASTER, AGENT_MODEL_DEVELOPER, AGENT_MODEL_QA,
# AGENT_MODEL_SECOPS, AGENT_MODEL_TECH_WRITER, AGENT_MODEL_ENGRAM_PROCESSOR.
# NEMOTRON_ROLES (below) wins over AGENT_MODEL for the roles it names, and an
# agent's own model on the Agents page wins over all of these. Use ids from
# GET /v1/models: the proxy refuses an id its provider does not list.
AGENT_MODEL=

# Run specific agent roles on NVIDIA Nemotron (served by Nebius). Empty means
# the Qwen/DeepSeek defaults in backend/llm/model_factory.py. Roles:
# PO, Architect, ScrumMaster, Developer, QA, SecOps, TechWriter.
# Read the real model ids from GET /v1/models (provider == "nebius") first.
NEMOTRON_ROLES=
NEMOTRON_MODEL=
NEMOTRON_MODEL_STRATEGIC=
NEMOTRON_MODEL_FAST=

# A company's own provider connections (the Models page): the backend sends the
# connection's key to the LLM proxy with each request, and the proxy accepts it
# only with this shared secret. Empty disables company connections. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
LLM_PROXY_INTERNAL_TOKEN=

# The model catalogue (models.dev): refreshed in the background every this many
# hours; 0 keeps the snapshot shipped with the backend and never calls out.
MODELS_CATALOG_REFRESH_HOURS=24

# Credential encryption (optional but recommended)
# Encrypts ProjectCredential values at rest. Without it they are stored with a
# "plaintext:" prefix and the backend warns at startup. Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_SECRET_KEY=

# JWT authentication (separate from FERNET_SECRET_KEY)
# Used to sign access tokens. Login returns 503 until this is configured.
# Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Authentication enforcement is on by default. Set false only for a local demo without a login.
AUTH_REQUIRED=true

# Audit signing (optional but recommended)
# Signs audit rows with HMAC-SHA256. Without it, rows carry an "unsigned:" prefix.
# Keep this key separate from FERNET_SECRET_KEY. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_SIGNING_KEY=

# Optional GitHub API token for backfill and webhook rate-limit headroom
GITHUB_TOKEN=
# Address GitHub uses to reach this backend for webhooks (the public host or a
# tunnel, e.g. https://fabrique.example.com). The GitHub page shows it as the
# webhook Payload URL; without it, the page falls back to the browser's API URL.
PUBLIC_API_URL=

# Support desk admins (comma-separated account emails). They see and triage every
# ticket and download the support logs; everyone else sees only the tickets they
# reported with their account email.
SUPPORT_ADMIN_EMAILS=
# The Support agent triages new tickets (suggested severity and category, a first
# reply to the reporter). Off by default: reporting a bug is public, and each new
# ticket costs an LLM call.
SUPPORT_AGENT_ENABLED=false
# The Reviewer agent suggests the decision on other producers' runs; a Manager decides.
REVIEWER_AGENT_ENABLED=false
# The Manager agent suggests each decision in the inbox and takes alone only what
# the company's policy allows (a Manager writes it); the client can override.
MANAGER_AGENT_ENABLED=false
# MCP tools: a Manager configures a company's servers in the app (POST
# /v1/mcp/servers with the standard mcpServers map); nothing to enable here.
# The task worker lets the model call them for at most this many rounds before
# it must answer, waits this long for one call, and shows the model at most
# this much of a result. Secrets (env, headers) are stored Fernet-encrypted.
MCP_MAX_TOOL_ROUNDS=6
MCP_TOOL_TIMEOUT_SECONDS=60
MCP_RESULT_MAX_CHARS=4000
# The Developer's workspace tools: the roles that deliver files may list, read
# and search the project through the daemon (and run its tests, with
# DELIVERY_TESTS_ENABLED) for at most this many rounds before delivering. Every
# read is evidence (the file's sha256 as the daemon read it).
DEVELOPER_TOOLS_ENABLED=true
DEVELOPER_TOOL_ROUNDS=8

# Company notification webhooks must reach a public https host; true allows a
# private, loopback or link-local one (a receiver on your own network).
WEBHOOK_ALLOW_PRIVATE_HOSTS=false

# The research tools: the roles that decide (RESEARCH_ROLES) read official
# documentation, the package registries and OSV through the backend, from the
# default hosts plus RESEARCH_ALLOWED_HOSTS (comma-separated, exact names) and
# the hosts a Manager adds per company. Every source is evidence. The registry
# URLs may point at a mirror.
RESEARCH_TOOLS_ENABLED=true
RESEARCH_ROLES=Architect,PO,SecOps,TechWriter
RESEARCH_ALLOWED_HOSTS=
RESEARCH_TOOL_ROUNDS=6

# Run the Alembic migrations to head when the backend starts, for a local
# database run by hand. The backend container's entrypoint and the e2e run
# `alembic upgrade head` themselves; the app refuses a database behind head.
DB_AUTO_UPGRADE=false

# Optional overrides
# Enable the internal LangGraph producer.
AGENT_GRAPH_ENABLED=false
# Run the project's tests after an agent's files are written and record the exit
# status as evidence. Off by default: it executes agent-written code on the machine
# running the VS Code daemon. DELIVERY_TEST_COMMAND overrides detection (npm test / pytest).
DELIVERY_TESTS_ENABLED=false
DELIVERY_TEST_COMMAND=
AGENT_MODEL_POLICY=
# Where that agent-written code runs: host (as before: the daemon's user, files
# and network), container (an ephemeral Docker/Podman container per run, the
# worktree mounted, network off, limits below, every capability dropped) or
# bwrap. A company can set its own; the daemon reports what it applied and the
# Verifier records it. FABRIQUE_SANDBOX_REQUIRED=container on the daemon's
# machine refuses the host for everything.
DELIVERY_SANDBOX=host
DELIVERY_SANDBOX_IMAGE=python:3.12-slim
DELIVERY_SANDBOX_NETWORK=false
DELIVERY_SANDBOX_CPUS=2
DELIVERY_SANDBOX_MEMORY_MB=2048
DELIVERY_SANDBOX_PIDS=512
# On the daemon's machine only (read by vscode-daemon): where it keeps the
# result of each queued delivery until the job is acknowledged, so a
# redelivered job replays it instead of applying SEARCH/REPLACE edits twice.
# Default ~/.fabrique-daemon/deliveries.
# FABRIQUE_DAEMON_STATE=
NATS_URL=nats://nats:4222
# Prefijo opcional para los nombres de streams, consumidores y subjects de
# JetStream. Poné uno distinto en cada despliegue que comparta un mismo NATS
# (por ejemplo `e2e` para la corrida end-to-end): los streams son work-queue,
# así que dos stacks con los mismos nombres se roban los mensajes entre sí.
NATS_NAMESPACE=
BACKEND_URL=http://localhost:8000
LLM_PROXY_URL=http://llm-proxy:5100
NEO4J_ENABLED=true
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
CONTAINER_WORKSPACE_ROOT=/workspace
# The workspace daemon runs on your computer (scripts/start-daemon.sh on
# macOS/Linux, scripts/start-daemon.ps1 on Windows) and connects to NATS on
# localhost:4222. NATS_BIND=0.0.0.0 exposes NATS to other machines; only do
# that on a trusted network, since NATS clients can ask the daemon to run commands.
# NATS_BIND=127.0.0.1
# One NATS user per component (SECURITY.md §8.6, docs/OPERATIONS.md "Securing
# the bus"): set both passwords to turn authentication on (nats/start.sh loads
# nats/nats-server.conf), neither to keep the old unauthenticated bus; only one
# set stops the broker. The backend connects as "backend"; start the daemon
# with NATS_DAEMON_PASSWORD (user "daemon") or --creds FILE.
# NATS_BACKEND_PASSWORD=
# NATS_DAEMON_PASSWORD=
# Instead of a password, a component may use a .creds file (wins) or an nkey
# seed file: NATS_CREDS_FILE=, NATS_NKEY_SEED=; or NATS_USER= / NATS_PASSWORD=.
# TLS: the broker requires it once nats/certs holds server.crt and server.key;
# with NATS_TLS=true (or NATS_TLS_VERIFY=true) it refuses to start if one of
# the files it then needs is missing.
# NATS_TLS=true makes the backend and the daemon connect with TLS; NATS_TLS_CA
# pins the CA (the backend container reads nats/certs/ca.crt); NATS_TLS_CERT /
# NATS_TLS_KEY present a client certificate, which NATS_TLS_VERIFY=true makes
# the broker require.
# NATS_TLS=false
# NATS_TLS_CA=
# NATS_TLS_CERT=
# NATS_TLS_KEY=
# NATS_TLS_VERIFY=false
# Client certificates for the containers: file names inside nats/certs, which
# compose mounts at /etc/fabrique-nats/certs and passes on as NATS_TLS_CERT /
# NATS_TLS_KEY (e.g. /etc/fabrique-nats/certs/backend.crt). Empty: none.
# NATS_BACKEND_TLS_CERT=
# NATS_BACKEND_TLS_KEY=
# NATS_DAEMON_TLS_CERT=
# NATS_DAEMON_TLS_KEY=
# Only for the optional Linux-only daemon container
# (docker compose --profile docker-daemon up): the host folder with your
# projects, mounted at the same path. Defaults to your home directory.
# PROJECTS_ROOT=/absolute/path/to/your/projects

# --- Retention (the janitor, backend/janitor/retention.py; docs/OPERATIONS.md) ---
# Days to keep; 0 keeps everything. A row of a company's audit hash chain is
# never deleted, and there is no audit retention: archive the chain instead.
RETENTION_OUTBOX_DAYS=7
RETENTION_AGENT_RUNS_DAYS=0
RETENTION_KPI_TURNS_DAYS=0
RETENTION_GLASSROOM_DAYS=0
