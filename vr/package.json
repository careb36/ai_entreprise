{
  "name": "fabrique-glassroom-vr",
  "private": true,
  "version": "0.1.0",
  "description": "Glassroom VR: a hands-first WebXR room where a person watches Le Fabrique's agents work and reviews their evidence",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.18.0",
    "@react-three/xr": "5.7.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "0.172.0"
  },
  "devDependencies": {
    "@react-three/test-renderer": "8.2.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "0.172.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^3.2.4"
  }
}
