{
  "name": "factory-vscode",
  "displayName": "Factory System",
  "description": "VS Code extension for Factory system integration",
  "version": "0.1.0",
  "publisher": "factory",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage",
    "onCommand:factory.connect",
    "onCommand:factory.runTask",
    "onCommand:factory.showMemory",
    "onCommand:factory.startSprint",
    "onCommand:factory.streamGlassroom",
    "onCommand:factory.glassroomPanel"
  ],
  "main": "./extension",
  "contributes": {
    "commands": [
      {
        "command": "factory.connect",
        "title": "Factory: Connect"
      },
      {
        "command": "factory.runTask",
        "title": "Factory: Run Task"
      },
      {
        "command": "factory.showMemory",
        "title": "Factory: Show Memory Search"
      },
      {
        "command": "factory.startSprint",
        "title": "Factory: Start Sprint"
      },
      {
        "command": "factory.streamGlassroom",
        "title": "Factory: Stream Glassroom Events (terminal)"
      },
      {
        "command": "factory.glassroomPanel",
        "title": "Factory: Open GlassRoom Panel"
      }
    ],
    "statusBar": {
      "id": "factory-status",
      "name": "Factory: Connected",
      "priority": 100
    },
    "configuration": {
      "title": "Factory",
      "properties": {
        "factory.backendUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "Factory backend URL"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.0.0"
  }
}
