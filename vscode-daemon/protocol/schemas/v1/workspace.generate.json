{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fabrique:daemon-protocol:v1:workspace.generate",
  "title": "workspace.generate",
  "description": "Write files into the project: a snapshot to undo it, or with `git` a commit on the task's branch in a worktree (daemon.py, delivery.py). A request without files gets no reply: sprint kickoff stories share the subject.",
  "x-protocol-version": 1,
  "x-subject": "workspace.generate",
  "x-kind": "request",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "workspace_root": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "content": {
                "type": "string"
              },
              "edits": {
                "type": "array"
              },
              "overwrite_existing": {
                "type": "boolean"
              },
              "safe_replace": {
                "type": "boolean"
              }
            },
            "required": [
              "path"
            ]
          }
        },
        "git": {
          "type": "object",
          "properties": {
            "branch": {
              "type": "string"
            },
            "base": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "merge": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "branch"
          ]
        },
        "sprint_id": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "interaction_id": {
          "type": "string"
        }
      },
      "required": [
        "files"
      ]
    },
    "reply": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "workspace_root": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "written",
                  "skipped_protected",
                  "rejected",
                  "rejected_edit",
                  "rejected_syntax",
                  "workspace_missing"
                ]
              },
              "absolute_path": {
                "type": "string"
              },
              "bytes": {
                "type": "integer"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "error": {
                "type": "string"
              },
              "edits_applied": {
                "type": "integer"
              }
            },
            "required": [
              "path",
              "status"
            ]
          }
        },
        "snapshot": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "files": {
              "type": "array"
            }
          },
          "required": [
            "id"
          ]
        },
        "git": {
          "type": "object"
        },
        "git_workflow_skipped": {
          "type": "string"
        },
        "project_files": {
          "type": "object",
          "properties": {
            "files": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "required": [
            "files",
            "truncated"
          ]
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "files"
      ]
    }
  }
}
