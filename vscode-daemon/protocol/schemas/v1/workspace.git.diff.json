{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fabrique:daemon-protocol:v1:workspace.git.diff",
  "title": "workspace.git.diff",
  "description": "The diff a sprint's integration brings into its base: the files between the merge base of base and the pinned commit, their hunks and the sha256 of each side, read-only (git_diff.py). With view, one of the agents' fixed read-only views of a task's repository instead (git_view.py, PROTOCOL.md section 5.6).",
  "x-protocol-version": 1,
  "x-subject": "workspace.git.diff",
  "x-kind": "request",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "workspace_root": {
          "type": "string",
          "minLength": 1,
          "description": "An absolute path on the daemon's machine."
        },
        "base": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "forge_policy": {
          "type": "string",
          "enum": [
            "none",
            "fetch",
            "publish"
          ],
          "description": "The company's forge policy (issue #727, PROTOCOL.md section 5.3). Missing or unknown reads as none; capped by the daemon's FORGE_POLICY_MAX."
        },
        "view": {
          "type": "string",
          "enum": [
            "status",
            "changed",
            "diff",
            "log"
          ],
          "description": "An agent's read-only view instead of the integration diff (git_view.py, PROTOCOL.md section 5.6); announced as the view feature of this subject."
        },
        "path": {
          "type": "string",
          "description": "With view diff: a path relative to workspace_root, inside it, never VCS metadata or a file that may hold secrets."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "description": "With view log: how many commits (default 10)."
        }
      },
      "required": [
        "workspace_root"
      ],
      "anyOf": [
        {
          "required": [
            "commit"
          ]
        },
        {
          "required": [
            "view"
          ]
        }
      ]
    },
    "file": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "old_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "change": {
          "type": "string"
        },
        "additions": {
          "type": "integer"
        },
        "deletions": {
          "type": "integer"
        },
        "patch": {
          "type": [
            "string",
            "null"
          ]
        },
        "omitted": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256_old": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "sha256_new": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "change"
      ]
    },
    "ok": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "base": {
          "type": "string"
        },
        "base_commit": {
          "type": "string"
        },
        "merge_base": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "truncated": {
          "type": "boolean"
        },
        "view": {
          "type": "string"
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "from": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "path"
            ]
          }
        },
        "count": {
          "type": "integer"
        },
        "path": {
          "type": "string"
        },
        "untracked": {
          "type": "boolean"
        },
        "commits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "commit": {
                "type": "string"
              },
              "subject": {
                "type": "string"
              }
            },
            "required": [
              "commit",
              "subject"
            ]
          }
        },
        "limit": {
          "type": "integer"
        },
        "patch": {
          "type": [
            "string",
            "null"
          ],
          "description": "With view diff: the path's diff against the merge base, bounded."
        }
      },
      "required": [
        "ok"
      ]
    },
    "refusal": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "status": {
              "type": "integer",
              "minimum": 400,
              "maximum": 599
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "message"
          ]
        }
      },
      "required": [
        "error"
      ]
    },
    "reply": {
      "anyOf": [
        {
          "$ref": "#/$defs/refusal"
        },
        {
          "$ref": "#/$defs/ok"
        }
      ]
    }
  }
}
