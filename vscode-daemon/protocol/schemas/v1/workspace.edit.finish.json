{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fabrique:daemon-protocol:v1:workspace.edit.finish",
  "title": "workspace.edit.finish",
  "description": "The final texts of a session's edits; the originals are back on disk (workspace_edit.py).",
  "x-protocol-version": 1,
  "x-subject": "workspace.edit.finish",
  "x-kind": "request",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "workspace_root": {
          "type": "string",
          "minLength": 1,
          "description": "An absolute path on the daemon's machine."
        },
        "session": {
          "type": "string"
        }
      },
      "required": [
        "workspace_root",
        "session"
      ]
    },
    "ok": {
      "type": "object",
      "properties": {
        "session": {},
        "files": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "session",
        "files"
      ]
    },
    "refusal": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "status": {
              "type": "integer",
              "minimum": 400,
              "maximum": 599
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "message"
          ]
        }
      },
      "required": [
        "error"
      ]
    },
    "reply": {
      "anyOf": [
        {
          "$ref": "#/$defs/refusal"
        },
        {
          "$ref": "#/$defs/ok"
        }
      ]
    }
  }
}
