{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fabrique:daemon-protocol:v1:workspace.git.merge",
  "title": "workspace.git.merge",
  "description": "Merge a fabrique/ branch into a base branch of the local repository, nothing pushed (local_merge.py).",
  "x-protocol-version": 1,
  "x-subject": "workspace.git.merge",
  "x-kind": "request",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "workspace_root": {
          "type": "string",
          "minLength": 1,
          "description": "An absolute path on the daemon's machine."
        },
        "branch": {
          "type": "string"
        },
        "base": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "forge_policy": {
          "type": "string",
          "enum": [
            "none",
            "fetch",
            "publish"
          ],
          "description": "The company's forge policy (issue #727, PROTOCOL.md section 5.3). Missing or unknown reads as none; capped by the daemon's FORGE_POLICY_MAX."
        }
      },
      "required": [
        "workspace_root",
        "branch"
      ]
    },
    "ok": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "branch": {
          "type": "string"
        },
        "base": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "before": {
          "type": "string"
        },
        "after": {
          "type": "string"
        },
        "already": {
          "type": "boolean"
        },
        "fast_forward": {
          "type": "boolean"
        }
      },
      "required": [
        "ok"
      ]
    },
    "refusal": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "status": {
              "type": "integer",
              "minimum": 400,
              "maximum": 599
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "message"
          ]
        }
      },
      "required": [
        "error"
      ]
    },
    "reply": {
      "anyOf": [
        {
          "$ref": "#/$defs/refusal"
        },
        {
          "$ref": "#/$defs/ok"
        }
      ]
    }
  }
}
