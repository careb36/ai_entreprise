{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fabrique:daemon-protocol:v1:workspace.edit",
  "title": "workspace.edit",
  "description": "One checked edit, move of lines or deletion of an emptied file in the task's working copy (workspace_edit.py, workspace_move.py, §5.1.4).",
  "x-protocol-version": 1,
  "x-subject": "workspace.edit",
  "x-kind": "request",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "workspace_root": {
          "type": "string",
          "minLength": 1,
          "description": "An absolute path on the daemon's machine."
        },
        "session": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "start_line": {},
        "end_line": {},
        "new_text": {
          "type": "string"
        },
        "search": {
          "type": "string"
        },
        "replace": {
          "type": "string"
        },
        "op": {
          "enum": [
            "edit",
            "move",
            "delete"
          ],
          "description": "edit (the default), move or delete (§5.1.4)."
        },
        "to_path": {
          "type": "string"
        },
        "to_line": {}
      },
      "required": [
        "workspace_root",
        "session",
        "path"
      ]
    },
    "ok": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256_before": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sha256_after": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer"
        },
        "lines": {
          "type": "integer"
        },
        "checked": {},
        "first_line": {
          "type": "integer"
        },
        "last_line": {
          "type": "integer"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256_before",
        "sha256_after",
        "bytes",
        "lines"
      ]
    },
    "refusal": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "status": {
              "type": "integer",
              "minimum": 400,
              "maximum": 599
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "message"
          ]
        }
      },
      "required": [
        "error"
      ]
    },
    "reply": {
      "anyOf": [
        {
          "$ref": "#/$defs/refusal"
        },
        {
          "$ref": "#/$defs/ok"
        },
        {
          "$ref": "#/$defs/move"
        },
        {
          "$ref": "#/$defs/delete"
        }
      ]
    },
    "move": {
      "type": "object",
      "properties": {
        "op": {
          "const": "move"
        },
        "path": {
          "type": "string"
        },
        "to_path": {
          "type": "string"
        },
        "moved_lines": {
          "type": "integer"
        },
        "moved_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256_before": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sha256_after": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "lines": {
              "type": "integer"
            },
            "created": {
              "type": "boolean"
            }
          },
          "required": [
            "path",
            "sha256_after"
          ]
        },
        "target": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256_before": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sha256_after": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "lines": {
              "type": "integer"
            },
            "created": {
              "type": "boolean"
            }
          },
          "required": [
            "path",
            "sha256_after"
          ]
        },
        "first_line": {
          "type": "integer"
        },
        "last_line": {
          "type": "integer"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "path",
        "to_path",
        "moved_lines",
        "moved_sha256",
        "source",
        "target"
      ]
    },
    "delete": {
      "type": "object",
      "properties": {
        "op": {
          "const": "delete"
        },
        "path": {
          "type": "string"
        },
        "deleted": {
          "const": true
        },
        "sha256_before": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_by_session": {
          "type": "boolean"
        }
      },
      "required": [
        "op",
        "path",
        "deleted"
      ]
    }
  }
}
