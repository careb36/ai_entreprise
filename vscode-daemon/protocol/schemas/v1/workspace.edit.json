{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fabrique:daemon-protocol:v1:workspace.edit",
  "title": "workspace.edit",
  "description": "One checked edit of an existing file in the task's working copy (workspace_edit.py).",
  "x-protocol-version": 1,
  "x-subject": "workspace.edit",
  "x-kind": "request",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "workspace_root": {
          "type": "string",
          "minLength": 1,
          "description": "An absolute path on the daemon's machine."
        },
        "session": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "start_line": {},
        "end_line": {},
        "new_text": {
          "type": "string"
        },
        "search": {
          "type": "string"
        },
        "replace": {
          "type": "string"
        }
      },
      "required": [
        "workspace_root",
        "session",
        "path"
      ]
    },
    "ok": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256_before": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sha256_after": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer"
        },
        "lines": {
          "type": "integer"
        },
        "checked": {},
        "first_line": {
          "type": "integer"
        },
        "last_line": {
          "type": "integer"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256_before",
        "sha256_after",
        "bytes",
        "lines"
      ]
    },
    "refusal": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "status": {
              "type": "integer",
              "minimum": 400,
              "maximum": 599
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "message"
          ]
        }
      },
      "required": [
        "error"
      ]
    },
    "reply": {
      "anyOf": [
        {
          "$ref": "#/$defs/refusal"
        },
        {
          "$ref": "#/$defs/ok"
        }
      ]
    }
  }
}
