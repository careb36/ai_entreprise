{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fabrique:daemon-protocol:v1:workspace.self_host.push",
  "title": "workspace.self_host.push",
  "description": "A fast-forward of origin's main to the previewed main, with land.sh's notes ref, using this machine's own git credentials (self_host_git.py, PROTOCOL.md \u00a75.10). Never --force, never a + refspec.",
  "x-protocol-version": 1,
  "x-subject": "workspace.self_host.push",
  "x-kind": "request",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "main": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "origin_main": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        }
      },
      "required": [
        "main",
        "origin_main"
      ]
    },
    "ok": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "before": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "after": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "main": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "pushed": {
          "type": "boolean"
        },
        "notes_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "refspecs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^+]"
          }
        },
        "remote_url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "ok",
        "before",
        "after",
        "main",
        "pushed",
        "notes_ref",
        "refspecs",
        "remote_url"
      ]
    },
    "refusal": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "status": {
              "type": "integer",
              "minimum": 400,
              "maximum": 599
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "message"
          ]
        }
      },
      "required": [
        "error"
      ]
    },
    "reply": {
      "anyOf": [
        {
          "$ref": "#/$defs/refusal"
        },
        {
          "$ref": "#/$defs/ok"
        }
      ]
    }
  }
}
