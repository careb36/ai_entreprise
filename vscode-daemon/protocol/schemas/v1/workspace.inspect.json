{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fabrique:daemon-protocol:v1:workspace.inspect",
  "title": "workspace.inspect",
  "description": "Whether a path is a folder on the daemon's machine, its git remote and branch, and optionally a file snapshot for stack detection (host_folders.py).",
  "x-protocol-version": 1,
  "x-subject": "workspace.inspect",
  "x-kind": "request",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "snapshot": {
          "type": "boolean"
        }
      },
      "required": [
        "path"
      ]
    },
    "ok": {
      "type": "object",
      "properties": {
        "host": {
          "type": "object",
          "properties": {
            "hostname": {
              "type": "string"
            },
            "platform": {
              "type": "string"
            },
            "home": {
              "type": "string"
            },
            "sep": {
              "type": "string"
            }
          },
          "required": [
            "hostname",
            "platform",
            "home",
            "sep"
          ]
        },
        "path": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "exists": {
          "type": "boolean"
        },
        "is_dir": {
          "type": "boolean"
        },
        "git": {
          "type": [
            "object",
            "null"
          ]
        },
        "snapshot": {
          "type": "object",
          "properties": {
            "files": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "contents": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "truncated": {
              "type": "boolean"
            },
            "playwright": {
              "type": "object",
              "description": "The Playwright the project pins, read by the daemon from its package.json and lockfile (playwright_pin.py, issue #315): `version` and the file it came `from`, or `null` with the `reason`; `declared` false when the project lists no Playwright. The backend picks the browser image from it.",
              "properties": {
                "declared": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "package": {
                  "type": "string"
                },
                "spec": {
                  "type": "string"
                },
                "version": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.]+)?$"
                },
                "from": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "observed_by": {
                  "const": "daemon"
                }
              },
              "required": [
                "declared",
                "version",
                "observed_by"
              ]
            }
          },
          "required": [
            "files",
            "contents",
            "truncated"
          ]
        }
      },
      "required": [
        "host",
        "path",
        "name",
        "exists",
        "is_dir",
        "git"
      ]
    },
    "refusal": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "status": {
              "type": "integer",
              "minimum": 400,
              "maximum": 599
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "message"
          ]
        }
      },
      "required": [
        "error"
      ]
    },
    "reply": {
      "anyOf": [
        {
          "$ref": "#/$defs/refusal"
        },
        {
          "$ref": "#/$defs/ok"
        }
      ]
    }
  }
}
