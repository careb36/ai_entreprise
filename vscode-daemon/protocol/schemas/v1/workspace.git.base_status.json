{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fabrique:daemon-protocol:v1:workspace.git.base_status",
  "title": "workspace.git.base_status",
  "description": "Whether the folder is a repository and how its base branch stands against its remote, fetched now (git_base.py).",
  "x-protocol-version": 1,
  "x-subject": "workspace.git.base_status",
  "x-kind": "request",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "workspace_root": {
          "type": "string",
          "minLength": 1,
          "description": "An absolute path on the daemon's machine."
        },
        "base": {
          "type": "string"
        },
        "forge_policy": {
          "type": "string",
          "enum": [
            "none",
            "fetch",
            "publish"
          ],
          "description": "The company's forge policy (issue #727, PROTOCOL.md section 5.3). Missing or unknown reads as none; capped by the daemon's FORGE_POLICY_MAX."
        }
      },
      "required": [
        "workspace_root"
      ]
    },
    "ok": {
      "type": "object",
      "properties": {
        "is_repo": {
          "type": "boolean"
        },
        "repository": {
          "type": "string"
        }
      },
      "required": [
        "is_repo"
      ]
    },
    "refusal": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "status": {
              "type": "integer",
              "minimum": 400,
              "maximum": 599
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "message"
          ]
        }
      },
      "required": [
        "error"
      ]
    },
    "reply": {
      "anyOf": [
        {
          "$ref": "#/$defs/refusal"
        },
        {
          "$ref": "#/$defs/ok"
        }
      ]
    }
  }
}
