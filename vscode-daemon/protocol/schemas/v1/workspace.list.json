{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fabrique:daemon-protocol:v1:workspace.list",
  "title": "workspace.list",
  "description": "The project's tree under a path, bounded (workspace_read.py).",
  "x-protocol-version": 1,
  "x-subject": "workspace.list",
  "x-kind": "request",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "workspace_root": {
          "type": "string",
          "minLength": 1,
          "description": "An absolute path on the daemon's machine."
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "depth": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "workspace_root"
      ]
    },
    "ok": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "entries",
        "truncated"
      ]
    },
    "refusal": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "status": {
              "type": "integer",
              "minimum": 400,
              "maximum": 599
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "message"
          ]
        }
      },
      "required": [
        "error"
      ]
    },
    "reply": {
      "anyOf": [
        {
          "$ref": "#/$defs/refusal"
        },
        {
          "$ref": "#/$defs/ok"
        }
      ]
    }
  }
}
