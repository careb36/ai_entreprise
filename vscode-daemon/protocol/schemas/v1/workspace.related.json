{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fabrique:daemon-protocol:v1:workspace.related",
  "title": "workspace.related",
  "description": "The files around a task's seeds and the names that tie them: paths, names and sha256, never contents (code_graph.py); with lookup, where a name is defined or who uses it (code_lookup.py); with api_surface, config_vars or dependencies, what the project declares (project_facts.py).",
  "x-protocol-version": 1,
  "x-subject": "workspace.related",
  "x-kind": "request",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "workspace_root": {
          "type": "string",
          "minLength": 1,
          "description": "An absolute path on the daemon's machine."
        },
        "seeds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hops": {
          "type": "integer"
        },
        "max_files": {
          "type": "integer"
        },
        "lookup": {
          "type": "object",
          "description": "Optional (feature `lookup`, \u00a75.7): a definition or references lookup instead of a walk from seeds; with the features `api_surface`, `config_vars` and `dependencies` (\u00a75.9), what the project declares.",
          "properties": {
            "kind": {
              "enum": [
                "definition",
                "references",
                "api_surface",
                "config_vars",
                "dependencies"
              ]
            },
            "name": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "kind"
          ]
        }
      },
      "required": [
        "workspace_root",
        "seeds"
      ]
    },
    "ok": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "hop": {
                "type": "integer"
              },
              "seed": {
                "type": "boolean"
              },
              "uses": {
                "type": "array"
              },
              "used_by": {
                "type": "array"
              },
              "more_uses": {
                "type": "integer"
              },
              "more_used_by": {
                "type": "integer"
              }
            },
            "required": [
              "path",
              "hop",
              "seed"
            ]
          }
        },
        "partial": {
          "type": "boolean"
        },
        "seeds_matched": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "seeds_unmatched": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lookup": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "definition",
                "references",
                "api_surface",
                "config_vars",
                "dependencies"
              ]
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "path_found": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "definitions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string"
                  },
                  "line": {
                    "type": "integer"
                  },
                  "depth": {
                    "type": "integer"
                  },
                  "signature": {
                    "type": "string"
                  },
                  "parameters": {
                    "type": "object"
                  }
                },
                "required": [
                  "path",
                  "sha256",
                  "line",
                  "signature"
                ]
              }
            },
            "references": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string"
                  },
                  "names": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "lines": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  },
                  "more_lines": {
                    "type": "integer"
                  }
                },
                "required": [
                  "path",
                  "sha256",
                  "names",
                  "lines"
                ]
              }
            },
            "more": {
              "type": "integer"
            },
            "common_name": {
              "type": "boolean"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ]
              }
            },
            "files_scanned": {
              "type": "integer"
            },
            "scanned_sha256": {
              "type": "string"
            },
            "openapi": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string"
                  },
                  "operations": {
                    "type": "array"
                  },
                  "error": {
                    "type": "string"
                  }
                },
                "required": [
                  "path"
                ]
              }
            },
            "routes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "method": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "function": {
                    "type": "string"
                  },
                  "file": {
                    "type": "string"
                  },
                  "line": {
                    "type": "integer"
                  }
                },
                "required": [
                  "method",
                  "path",
                  "function",
                  "file",
                  "line"
                ]
              }
            },
            "mounts": {
              "type": "array"
            },
            "variables": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "file": {
                    "type": "string"
                  },
                  "line": {
                    "type": "integer"
                  },
                  "source": {
                    "type": "string"
                  },
                  "default": {
                    "type": "string"
                  },
                  "default_withheld": {
                    "type": "boolean"
                  },
                  "required": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "name",
                  "file",
                  "line",
                  "source"
                ]
              }
            },
            "manifests": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string"
                  },
                  "ecosystem": {
                    "enum": [
                      "pypi",
                      "npm"
                    ]
                  },
                  "count": {
                    "type": "integer"
                  },
                  "error": {
                    "type": "string"
                  }
                },
                "required": [
                  "path",
                  "ecosystem"
                ]
              }
            },
            "dependencies": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "manifest": {
                    "type": "string"
                  },
                  "ecosystem": {
                    "enum": [
                      "pypi",
                      "npm"
                    ]
                  },
                  "name": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  },
                  "group": {
                    "type": "string"
                  }
                },
                "required": [
                  "manifest",
                  "ecosystem",
                  "name",
                  "version",
                  "group"
                ]
              }
            }
          },
          "required": [
            "kind",
            "definitions",
            "references",
            "more"
          ]
        }
      },
      "required": [
        "files",
        "partial",
        "seeds_matched",
        "seeds_unmatched"
      ]
    },
    "refusal": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "status": {
              "type": "integer",
              "minimum": 400,
              "maximum": 599
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "message"
          ]
        }
      },
      "required": [
        "error"
      ]
    },
    "reply": {
      "anyOf": [
        {
          "$ref": "#/$defs/refusal"
        },
        {
          "$ref": "#/$defs/ok"
        }
      ]
    }
  }
}
