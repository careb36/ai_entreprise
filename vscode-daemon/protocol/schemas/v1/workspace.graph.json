{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fabrique:daemon-protocol:v1:workspace.graph",
  "title": "workspace.graph",
  "description": "The parse of each file whose sha256 the backend does not hold, for the stored code graph: paths, sha256, definition names and lines, and the names each file uses, never contents (code_graph.py).",
  "x-protocol-version": 1,
  "x-subject": "workspace.graph",
  "x-kind": "request",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "workspace_root": {
          "type": "string",
          "minLength": 1,
          "description": "An absolute path on the daemon's machine."
        },
        "known": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "The sha256 the backend holds per project-relative path."
        },
        "max_files": {
          "type": "integer"
        }
      },
      "required": [
        "workspace_root",
        "known"
      ]
    },
    "ok": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "status": {
                "type": "string",
                "enum": [
                  "parsed",
                  "unparsed",
                  "refs_skipped"
                ]
              },
              "defs": {
                "type": "array",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    },
                    {
                      "type": "integer"
                    }
                  ]
                }
              },
              "refs": {
                "type": "array",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ]
                }
              },
              "truncated": {
                "type": "boolean"
              }
            },
            "required": [
              "path",
              "sha256",
              "status",
              "defs",
              "refs"
            ]
          }
        },
        "unchanged": {
          "type": "integer"
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "more": {
          "type": "boolean"
        },
        "partial": {
          "type": "boolean"
        }
      },
      "required": [
        "files",
        "unchanged",
        "removed",
        "more",
        "partial"
      ]
    },
    "refusal": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "status": {
              "type": "integer",
              "minimum": 400,
              "maximum": 599
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "message"
          ]
        }
      },
      "required": [
        "error"
      ]
    },
    "reply": {
      "anyOf": [
        {
          "$ref": "#/$defs/refusal"
        },
        {
          "$ref": "#/$defs/ok"
        }
      ]
    }
  }
}
