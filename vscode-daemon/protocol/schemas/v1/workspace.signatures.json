{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fabrique:daemon-protocol:v1:workspace.signatures",
  "title": "workspace.signatures",
  "description": "The signatures of named module-level Python definitions, per file with its sha256 (signatures.py).",
  "x-protocol-version": 1,
  "x-subject": "workspace.signatures",
  "x-kind": "request",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "workspace_root": {
          "type": "string",
          "minLength": 1,
          "description": "An absolute path on the daemon's machine."
        },
        "wanted": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "names": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "path"
            ]
          }
        }
      },
      "required": [
        "workspace_root",
        "wanted"
      ]
    },
    "ok": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "read",
                  "refused",
                  "unreadable",
                  "does not parse"
                ]
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "reason": {
                "type": "string"
              },
              "names": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "enum": [
                        "found",
                        "unknown",
                        "missing"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            },
            "required": [
              "path",
              "status"
            ]
          }
        }
      },
      "required": [
        "files"
      ]
    },
    "refusal": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "status": {
              "type": "integer",
              "minimum": 400,
              "maximum": 599
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "message"
          ]
        }
      },
      "required": [
        "error"
      ]
    },
    "reply": {
      "anyOf": [
        {
          "$ref": "#/$defs/refusal"
        },
        {
          "$ref": "#/$defs/ok"
        }
      ]
    }
  }
}
