{
  "name": "fabrique-frontend",
  "version": "1.0.0",
  "description": "Fabrique - Electron+React desktop frontend for Multi-Agent System",
  "main": "electron/main.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.96.2",
    "autoprefixer": "^10.4.16",
    "axios": "^1.6.2",
    "i18next": "^26.0.3",
    "lucide-react": "^0.303.0",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.2",
    "react-router-dom": "^6.21.0",
    "tailwindcss": "^3.4.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.10"
  },
  "build": {
    "appId": "com.fabrique.enterprise",
    "productName": "Fabrique",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "icon": "public/fabrique-icon.svg"
    },
    "win": {
      "icon": "public/fabrique-icon.svg"
    },
    "linux": {
      "icon": "public/fabrique-icon.svg"
    }
  }
}
