{
  "name": "fabrique-frontend",
  "version": "1.0.0",
  "description": "Fabrique - Electron+React desktop frontend for Multi-Agent System",
  "main": "electron/main.ts",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint",
    "format:check": "prettier --check",
    "test": "vitest",
    "test:run": "vitest run",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.96.2",
    "autoprefixer": "^10.4.16",
    "date-fns": "^4.1.0",
    "i18next": "^26.0.3",
    "lucide-react": "^0.303.0",
    "moment": "^2.30.1",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-big-calendar": "^1.19.4",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.2",
    "react-router-dom": "^6.21.0",
    "tailwindcss": "^3.4.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.2.45",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "eslint": "^10.13.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^5.0.10",
    "vitest": "^3.2.6"
  },
  "build": {
    "appId": "com.fabrique.enterprise",
    "productName": "Fabrique",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "icon": "public/fabrique-icon.svg"
    },
    "win": {
      "icon": "public/fabrique-icon.svg"
    },
    "linux": {
      "icon": "public/fabrique-icon.svg"
    }
  },
  "overrides": {
    "tinypool": "2.1.2",
    "tar": "7.5.21"
  }
}
