{
  "name": "fabrique-frontend",
  "version": "1.0.0",
  "description": "Fabrique - Electron+React desktop frontend for Multi-Agent System",
  "homepage": "https://github.com/careb36/la-fabrique",
  "repository": {
    "type": "git",
    "url": "https://github.com/careb36/la-fabrique.git"
  },
  "main": "dist-electron-main/main.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:changed": "node scripts/test-changed.mjs",
    "lint": "eslint src",
    "preview": "vite preview",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:dev": "npm run electron:compile && concurrently -k \"vite\" \"electron . --dev\"",
    "electron:build": "npm run electron:compile && npm run build -- --mode electron && electron-builder"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.108.1",
    "date-fns": "^4.4.0",
    "i18next": "^27.2.2",
    "lucide-react": "^1.76.0",
    "moment": "^2.31.0",
    "react": "^18.2.0",
    "react-big-calendar": "^1.20.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^18.0.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.6",
    "remark-gfm": "4.0.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.2.45",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "concurrently": "^10.0.6",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "eslint-plugin-i18next": "^6.1.5",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "build": {
    "appId": "com.fabrique.enterprise",
    "productName": "Fabrique",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "dist-electron-main/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "careb36 <58278841+careb36@users.noreply.github.com>"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^6.1.5"
    },
    "eslint": {
      "minimatch": "^11.0.5"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.5"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    },
    "app-builder-lib": {
      "minimatch": "^11.0.5",
      "@electron/asar": {
        "minimatch": "^3.1.2"
      },
      "@electron/universal": {
        "minimatch": "^11.0.5",
        "dir-compare": {
          "minimatch": "^3.1.2"
        }
      }
    }
  }
}
